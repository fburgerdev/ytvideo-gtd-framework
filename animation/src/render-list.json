.465}, {"w": "wanted", "t": 30.66}, {"w": "to", "t": 31.13}, {"w": "study.", "t": 31.38}, {"w": "And", "t": 32.345}, {"w": "you", "t": 32.65}, {"w": "go", "t": 32.955}, {"w": "back.", "t": 33.205}], "lines": [{"t": 0.5, "e": 3.625, "text": "I think there's something deeper underneath."}, {"t": 3.925, "e": 5.89, "text": "This part is speculation."}, {"t": 6.79, "e": 8.675, "text": "You sit down to study."}, {"t": 8.975, "e": 11.33, "text": "You know that's what you want."}, {"t": 11.63, "e": 16.0, "text": "And a few minutes later, you're on Instagram, scrolling."}, {"t": 16.3, "e": 17.905, "text": "Nobody decided that."}, {"t": 18.205, "e": 20.335, "text": "It happens without thinking."}, {"t": 21.235, "e": 28.785, "text": "And then, at some point, maybe after ten seconds, maybe after forty minutes, something kicks in."}, {"t": 29.085, "e": 30.165, "text": "You realise:"}, {"t": 30.465, "e": 32.045, "text": "I wanted to study."}, {"t": 32.345, "e": 33.815, "text": "And you go back."}], "start": 389.5}, {"id": "5.23", "section": 5, "section_title": "The gap", "kind": "anim", "desc": "the gap", "key": "the-gap", "title": null, "stage": null, "pieces": [], "dur": 36.8667, "words": [{"w": "Two", "t": 0.5}, {"w": "things", "t": 0.805}, {"w": "happened", "t": 1.275}, {"w": "there.", "t": 1.855}, {"w": "One", "t": 2.82}, {"w": "part", "t": 3.125}, {"w": "of", "t": 3.485}, {"w": "you", "t": 3.735}, {"w": "runs", "t": 4.04}, {"w": "by", "t": 4.4}, {"w": "itself:", "t": 4.65}, {"w": "habits,", "t": 5.67}, {"w": "impulses,", "t": 6.36}, {"w": "the", "t": 7.16}, {"w": "next", "t": 7.465}, {"w": "obvious", "t": 7.825}, {"w": "thing.", "t": 8.35}, {"w": "And", "t": 9.315}, {"w": "another", "t": 9.62}, {"w": "part", "t": 10.145}, {"w": "notices.", "t": 10.505}, {"w": "It", "t": 11.58}, {"w": "looks", "t": 11.83}, {"w": "at", "t": 12.245}, {"w": "what", "t": 12.495}, {"w": "you're", "t": 12.855}, {"w": "doing", "t": 13.27}, {"w": "and", "t": 13.685}, {"w": "turns", "t": 13.99}, {"w": "you", "t": 14.405}, {"w": "around.", "t": 14.71}, {"w": "I'd", "t": 16.33}, {"w": "argue", "t": 16.58}, {"w": "that", "t": 16.995}, {"w": "what", "t": 17.355}, {"w": "we", "t": 17.715}, {"w": "call", "t": 17.965}, {"w": "consciousness", "t": 18.325}, {"w": "is", "t": 19.18}, {"w": "exactly", "t": 19.43}, {"w": "this", "t": 19.955}, {"w": "supervising", "t": 20.315}, {"w": "part.", "t": 21.06}, {"w": "Judging", "t": 21.97}, {"w": "what", "t": 22.495}, {"w": "we're", "t": 22.855}, {"w": "doing", "t": 23.215}, {"w": "right", "t": 23.63}, {"w": "now", "t": 24.045}, {"w": "against", "t": 24.35}, {"w": "what", "t": 24.875}, {"w": "we", "t": 25.235}, {"w": "want", "t": 25.485}, {"w": "to", "t": 25.845}, {"w": "do", "t": 26.095}, {"w": "with", "t": 26.345}, {"w": "our", "t": 26.705}, {"w": "lives,", "t": 27.01}, {"w": "our", "t": 27.645}, {"w": "goals.", "t": 27.95}, {"w": "And", "t": 28.915}, {"w": "readjusting.", "t": 29.22}, {"w": "And", "t": 31.115}, {"w": "the", "t": 31.42}, {"w": "time", "t": 31.725}, {"w": "between", "t": 32.085}, {"w": "drifting", "t": 32.61}, {"w": "off", "t": 33.19}, {"w": "and", "t": 33.495}, {"w": "noticing:", "t": 33.8}, {"w": "that's", "t": 34.93}, {"w": "the", "t": 35.345}, {"w": "gap.", "t": 35.65}], "lines": [{"t": 0.5, "e": 2.52, "text": "Two things happened there."}, {"t": 2.82, "e": 5.37, "text": "One part of you runs by itself:"}, {"t": 5.67, "e": 9.015, "text": "habits, impulses, the next obvious thing."}, {"t": 9.315, "e": 11.28, "text": "And another part notices."}, {"t": 11.58, "e": 15.43, "text": "It looks at what you're doing and turns you around."}, {"t": 16.33, "e": 21.67, "text": "I'd argue that what we call consciousness is exactly this supervising part."}, {"t": 21.97, "e": 28.615, "text": "Judging what we're doing right now against what we want to do with our lives, our goals."}, {"t": 28.915, "e": 30.215, "text": "And readjusting."}, {"t": 31.115, "e": 34.63, "text": "And the time between drifting off and noticing:"}, {"t": 34.93, "e": 36.205, "text": "that's the gap."}], "start": 423.9667}, {"id": "5.24", "section": 5, "section_title": "The gap", "kind": "anim", "desc": "the gap at every scale", "key": "the-gap-at-every-scale", "title": null, "stage": null, "pieces": [], "dur": 28.6667, "words": [{"w": "And", "t": 0.5}, {"w": "it's", "t": 0.805}, {"w": "not", "t": 1.11}, {"w": "only", "t": 1.415}, {"w": "about", "t": 1.775}, {"w": "Instagram.", "t": 2.19}, {"w": "You", "t": 3.375}, {"w": "plan", "t": 3.68}, {"w": "to", "t": 4.04}, {"w": "do", "t": 4.29}, {"w": "the", "t": 4.54}, {"w": "one", "t": 4.845}, {"w": "important", "t": 5.15}, {"w": "thing", "t": 5.785}, {"w": "today,", "t": 6.2}, {"w": "answer", "t": 6.835}, {"w": "a", "t": 7.305}, {"w": "few", "t": 7.5}, {"w": "mails", "t": 7.805}, {"w": "first,", "t": 8.22}, {"w": "and", "t": 8.855}, {"w": "at", "t": 9.16}, {"w": "six", "t": 9.41}, {"w": "in", "t": 9.715}, {"w": "the", "t": 9.965}, {"w": "evening", "t": 10.27}, {"w": "you", "t": 10.795}, {"w": "notice", "t": 11.1}, {"w": "it", "t": 11.57}, {"w": "didn't", "t": 11.82}, {"w": "happen.", "t": 12.235}, {"w": "Or", "t": 13.255}, {"w": "over", "t": 13.505}, {"w": "years:", "t": 13.865}, {"w": "you", "t": 14.83}, {"w": "study", "t": 15.135}, {"w": "what", "t": 15.55}, {"w": "made", "t": 15.91}, {"w": "sense,", "t": 16.27}, {"w": "take", "t": 16.905}, {"w": "the", "t": 17.265}, {"w": "job", "t": 17.57}, {"w": "that", "t": 17.875}, {"w": "came", "t": 18.235}, {"w": "next,", "t": 18.595}, {"w": "and", "t": 19.175}, {"w": "one", "t": 19.48}, {"w": "day", "t": 19.785}, {"w": "you", "t": 20.09}, {"w": "ask", "t": 20.395}, {"w": "yourself", "t": 20.7}, {"w": "whether", "t": 21.28}, {"w": "this", "t": 21.805}, {"w": "is", "t": 22.165}, {"w": "what", "t": 22.415}, {"w": "you", "t": 22.775}, {"w": "wanted.", "t": 23.08}, {"w": "Same", "t": 24.7}, {"w": "move.", "t": 25.06}, {"w": "Only", "t": 25.97}, {"w": "the", "t": 26.33}, {"w": "gap", "t": 26.635}, {"w": "gets", "t": 26.94}, {"w": "longer.", "t": 27.3}], "lines": [{"t": 0.5, "e": 3.075, "text": "And it's not only about Instagram."}, {"t": 3.375, "e": 12.955, "text": "You plan to do the one important thing today, answer a few mails first, and at six in the evening you notice it didn't happen."}, {"t": 13.255, "e": 14.53, "text": "Or over years:"}, {"t": 14.83, "e": 23.8, "text": "you study what made sense, take the job that came next, and one day you ask yourself whether this is what you wanted."}, {"t": 24.7, "e": 25.67, "text": "Same move."}, {"t": 25.97, "e": 28.02, "text": "Only the gap gets longer."}], "start": 460.8334}, {"id": "5.25", "section": 5, "section_title": "The gap", "kind": "anim", "desc": "meditation shortens the gap", "key": "meditation-shortens-the-gap", "title": null, "stage": null, "pieces": [], "dur": 30.0, "words": [{"w": "The", "t": 0.5}, {"w": "problem", "t": 0.805}, {"w": "is,", "t": 1.33}, {"w": "this", "t": 1.8}, {"w": "supervisor", "t": 2.16}, {"w": "is", "t": 2.85}, {"w": "weak.", "t": 3.1}, {"w": "One", "t": 4.01}, {"w": "study", "t": 4.315}, {"w": "found", "t": 4.73}, {"w": "that", "t": 5.145}, {"w": "our", "t": 5.505}, {"w": "minds", "t": 5.81}, {"w": "wander", "t": 6.225}, {"w": "almost", "t": 6.695}, {"w": "half", "t": 7.165}, {"w": "of", "t": 7.525}, {"w": "the", "t": 7.775}, {"w": "time", "t": 8.08}, {"w": "we're", "t": 8.44}, {"w": "awake.", "t": 8.8}, {"w": "But", "t": 10.365}, {"w": "it", "t": 10.67}, {"w": "can", "t": 10.92}, {"w": "be", "t": 11.225}, {"w": "trained.", "t": 11.475}, {"w": "That's", "t": 12.55}, {"w": "what", "t": 12.965}, {"w": "meditation", "t": 13.325}, {"w": "is.", "t": 14.015}, {"w": "You", "t": 14.815}, {"w": "sit,", "t": 15.12}, {"w": "you", "t": 15.645}, {"w": "focus", "t": 15.95}, {"w": "on", "t": 16.365}, {"w": "your", "t": 16.615}, {"w": "breath,", "t": 16.975}, {"w": "your", "t": 17.665}, {"w": "mind", "t": 18.025}, {"w": "wanders", "t": 18.385}, {"w": "off,", "t": 18.91}, {"w": "you", "t": 19.435}, {"w": "notice,", "t": 19.74}, {"w": "and", "t": 20.43}, {"w": "you", "t": 20.735}, {"w": "come", "t": 21.04}, {"w": "back.", "t": 21.4}, {"w": "That", "t": 22.31}, {"w": "moment", "t": 22.67}, {"w": "of", "t": 23.14}, {"w": "noticing", "t": 23.39}, {"w": "is", "t": 23.97}, {"w": "the", "t": 24.22}, {"w": "exercise.", "t": 24.525}, {"w": "And", "t": 25.655}, {"w": "every", "t": 25.96}, {"w": "time,", "t": 26.375}, {"w": "the", "t": 26.955}, {"w": "gap", "t": 27.26}, {"w": "gets", "t": 27.565}, {"w": "a", "t": 27.925}, {"w": "little", "t": 28.12}, {"w": "shorter.", "t": 28.59}], "lines": [{"t": 0.5, "e": 3.71, "text": "The problem is, this supervisor is weak."}, {"t": 4.01, "e": 9.465, "text": "One study found that our minds wander almost half of the time we're awake."}, {"t": 10.365, "e": 12.25, "text": "But it can be trained."}, {"t": 12.55, "e": 14.515, "text": "That's what meditation is."}, {"t": 14.815, "e": 22.01, "text": "You sit, you focus on your breath, your mind wanders off, you notice, and you come back."}, {"t": 22.31, "e": 25.355, "text": "That moment of noticing is the exercise."}, {"t": 25.655, "e": 29.365, "text": "And every time, the gap gets a little shorter."}], "start": 489.5001}, {"id": "5.26", "section": 5, "section_title": "The gap", "kind": "anim", "desc": "the file closes the gap", "key": "the-file-closes-the-gap", "title": null, "stage": null, "pieces": [], "dur": 24.9667, "words": [{"w": "And", "t": 0.5}, {"w": "that's", "t": 0.805}, {"w": "what", "t": 1.22}, {"w": "the", "t": 1.58}, {"w": "file", "t": 1.885}, {"w": "does", "t": 2.245}, {"w": "for", "t": 2.605}, {"w": "my", "t": 2.91}, {"w": "projects.", "t": 3.16}, {"w": "In", "t": 4.29}, {"w": "my", "t": 4.54}, {"w": "head,", "t": 4.79}, {"w": "I", "t": 5.37}, {"w": "jump", "t": 5.565}, {"w": "to", "t": 5.925}, {"w": "solutions,", "t": 6.175}, {"w": "or", "t": 7.03}, {"w": "the", "t": 7.28}, {"w": "AI", "t": 7.585}, {"w": "does,", "t": 7.835}, {"w": "and", "t": 8.415}, {"w": "it", "t": 8.72}, {"w": "can", "t": 8.97}, {"w": "take", "t": 9.275}, {"w": "weeks", "t": 9.635}, {"w": "until", "t": 10.05}, {"w": "I", "t": 10.465}, {"w": "notice.", "t": 10.66}, {"w": "On", "t": 11.68}, {"w": "a", "t": 11.93}, {"w": "page,", "t": 12.125}, {"w": "it", "t": 12.705}, {"w": "gets", "t": 12.955}, {"w": "noticed", "t": 13.315}, {"w": "much", "t": 13.84}, {"w": "earlier.", "t": 14.2}, {"w": "The", "t": 15.275}, {"w": "page", "t": 15.58}, {"w": "asks:", "t": 15.94}, {"w": "why", "t": 16.85}, {"w": "are", "t": 17.155}, {"w": "we", "t": 17.46}, {"w": "doing", "t": 17.71}, {"w": "this", "t": 18.125}, {"w": "again?", "t": 18.485}, {"w": "It's", "t": 19.45}, {"w": "a", "t": 19.755}, {"w": "supervisor", "t": 19.95}, {"w": "outside", "t": 20.64}, {"w": "my", "t": 21.165}, {"w": "head.", "t": 21.415}, {"w": "And", "t": 22.325}, {"w": "it", "t": 22.63}, {"w": "doesn't", "t": 22.88}, {"w": "get", "t": 23.35}, {"w": "tired.", "t": 23.655}], "lines": [{"t": 0.5, "e": 3.99, "text": "And that's what the file does for my projects."}, {"t": 4.29, "e": 11.38, "text": "In my head, I jump to solutions, or the AI does, and it can take weeks until I notice."}, {"t": 11.68, "e": 14.975, "text": "On a page, it gets noticed much earlier."}, {"t": 15.275, "e": 16.55, "text": "The page asks:"}, {"t": 16.85, "e": 19.15, "text": "why are we doing this again?"}, {"t": 19.45, "e": 22.025, "text": "It's a supervisor outside my head."}, {"t": 22.325, "e": 24.32, "text": "And it doesn't get tired."}], "start": 519.5001}, {"id": "5.27", "section": 5, "section_title": "The gap", "kind": "anim", "desc": "go up first", "key": "go-up-first", "title": null, "stage": null, "pieces": [], "dur": 21.8333, "words": [{"w": "So", "t": 0.5}, {"w": "if", "t": 0.75}, {"w": "you", "t": 1.0}, {"w": "take", "t": 1.305}, {"w": "one", "t": 1.665}, {"w": "thing", "t": 1.97}, {"w": "from", "t": 2.385}, {"w": "this:", "t": 2.745}, {"w": "before", "t": 3.655}, {"w": "you", "t": 4.125}, {"w": "ask", "t": 4.43}, {"w": "for", "t": 4.735}, {"w": "solutions,", "t": 5.04}, {"w": "from", "t": 5.895}, {"w": "an", "t": 6.255}, {"w": "AI,", "t": 6.505}, {"w": "from", "t": 6.975}, {"w": "a", "t": 7.335}, {"w": "friend,", "t": 7.53}, {"w": "from", "t": 8.22}, {"w": "yourself,", "t": 8.58}, {"w": "go", "t": 9.38}, {"w": "up", "t": 9.63}, {"w": "first.", "t": 9.88}, {"w": "Why", "t": 10.845}, {"w": "am", "t": 11.15}, {"w": "I", "t": 11.4}, {"w": "doing", "t": 11.595}, {"w": "this?", "t": 12.01}, {"w": "And", "t": 12.92}, {"w": "what", "t": 13.225}, {"w": "does", "t": 13.585}, {"w": "it", "t": 13.945}, {"w": "look", "t": 14.195}, {"w": "like", "t": 14.555}, {"w": "when", "t": 14.915}, {"w": "it", "t": 15.275}, {"w": "worked?", "t": 15.525}, {"w": "Five", "t": 17.145}, {"w": "lines.", "t": 17.505}], "lines": [{"t": 0.5, "e": 3.355, "text": "So if you take one thing from this:"}, {"t": 3.655, "e": 10.545, "text": "before you ask for solutions, from an AI, from a friend, from yourself, go up first."}, {"t": 10.845, "e": 12.62, "text": "Why am I doing this?"}, {"t": 12.92, "e": 16.245, "text": "And what does it look like when it worked?"}, {"t": 17.145, "e": 18.17, "text": "Five lines."}], "start": 544.4668}, {"id": "5.28", "section": 5, "section_title": "The gap", "kind": "anim", "desc": "thanks for watching", "key": "thanks-for-watching", "title": null, "stage": null, "pieces": [], "dur": 7.0, "words": [], "lines": [], "start": 566.3001}]}