{"captions": true, "blocks": [{"id": "1.00", "section": 1, "section_title": "The file", "kind": "anim", "desc": "one file", "key": "one-file", "title": null, "stage": null, "pieces": [], "dur": 28.3, "words": [{"w": "A", "t": 5.0}, {"w": "few", "t": 5.195}, {"w": "months", "t": 5.5}, {"w": "ago,", "t": 5.97}, {"w": "I", "t": 6.495}, {"w": "gave", "t": 6.69}, {"w": "my", "t": 7.05}, {"w": "AI", "t": 7.3}, {"w": "a", "t": 7.55}, {"w": "single", "t": 7.745}, {"w": "file.", "t": 8.215}, {"w": "One", "t": 9.125}, {"w": "page.", "t": 9.43}, {"w": "Five", "t": 10.34}, {"w": "steps", "t": 10.7}, {"w": "from", "t": 11.115}, {"w": "a", "t": 11.475}, {"w": "book", "t": 11.67}, {"w": "about", "t": 12.03}, {"w": "productivity.", "t": 12.445}, {"w": "I", "t": 14.395}, {"w": "expected", "t": 14.59}, {"w": "it", "t": 15.17}, {"w": "to", "t": 15.42}, {"w": "help", "t": 15.67}, {"w": "a", "t": 16.03}, {"w": "little.", "t": 16.225}, {"w": "It", "t": 17.245}, {"w": "changed", "t": 17.495}, {"w": "everything", "t": 18.02}, {"w": "about", "t": 18.71}, {"w": "how", "t": 19.125}, {"w": "I", "t": 19.43}, {"w": "work.", "t": 19.625}, {"w": "And", "t": 21.135}, {"w": "I", "t": 21.44}, {"w": "think", "t": 21.635}, {"w": "the", "t": 22.05}, {"w": "reason", "t": 22.355}, {"w": "says", "t": 22.825}, {"w": "something", "t": 23.185}, {"w": "about", "t": 23.82}, {"w": "how", "t": 24.235}, {"w": "we", "t": 24.54}, {"w": "think.", "t": 24.79}, {"w": "And", "t": 25.755}, {"w": "where", "t": 26.06}, {"w": "we", "t": 26.475}, {"w": "go", "t": 26.725}, {"w": "wrong.", "t": 26.975}], "lines": [{"t": 5.0, "e": 8.825, "text": "A few months ago, I gave my AI a single file."}, {"t": 9.125, "e": 10.04, "text": "One page."}, {"t": 10.34, "e": 13.495, "text": "Five steps from a book about productivity."}, {"t": 14.395, "e": 16.945, "text": "I expected it to help a little."}, {"t": 17.245, "e": 20.235, "text": "It changed everything about how I work."}, {"t": 21.135, "e": 25.455, "text": "And I think the reason says something about how we think."}, {"t": 25.755, "e": 27.64, "text": "And where we go wrong."}], "start": 0.0}, {"id": "1.01", "section": 1, "section_title": "The file", "kind": "anim", "desc": "title", "key": "title", "title": "The five lines I gave my AI", "stage": null, "pieces": [], "dur": 5.0, "words": [], "lines": [], "start": 28.3}, {"id": "2.02", "section": 2, "section_title": "Solutions first", "kind": "anim", "desc": "Solutions first", "key": "card", "title": "Solutions first", "stage": null, "pieces": [], "dur": 3.5, "words": [], "lines": [], "start": 33.3}, {"id": "2.03", "section": 2, "section_title": "Solutions first", "kind": "anim", "desc": "a problem in, options out", "key": "a-problem-in-options-out", "title": null, "stage": null, "pieces": [], "dur": 22.9333, "words": [{"w": "I", "t": 0.5}, {"w": "use", "t": 0.695}, {"w": "AI", "t": 1.0}, {"w": "as", "t": 1.25}, {"w": "a", "t": 1.5}, {"w": "sparring", "t": 1.695}, {"w": "partner.", "t": 2.275}, {"w": "For", "t": 3.35}, {"w": "my", "t": 3.655}, {"w": "projects,", "t": 3.905}, {"w": "for", "t": 4.705}, {"w": "decisions,", "t": 5.01}, {"w": "for", "t": 5.865}, {"w": "everything", "t": 6.17}, {"w": "I'm", "t": 6.86}, {"w": "stuck", "t": 7.11}, {"w": "on.", "t": 7.525}, {"w": "And", "t": 8.925}, {"w": "for", "t": 9.23}, {"w": "a", "t": 9.535}, {"w": "long", "t": 9.73}, {"w": "time,", "t": 10.09}, {"w": "every", "t": 10.67}, {"w": "conversation", "t": 11.085}, {"w": "went", "t": 11.885}, {"w": "the", "t": 12.245}, {"w": "same", "t": 12.55}, {"w": "way.", "t": 12.91}, {"w": "I", "t": 13.765}, {"w": "describe", "t": 13.96}, {"w": "a", "t": 14.54}, {"w": "problem.", "t": 14.735}, {"w": "And", "t": 15.81}, {"w": "I", "t": 16.115}, {"w": "get", "t": 16.31}, {"w": "options.", "t": 16.615}, {"w": "Five", "t": 17.69}, {"w": "ideas.", "t": 18.05}, {"w": "Ten", "t": 19.015}, {"w": "ideas.", "t": 19.32}, {"w": "Each", "t": 20.285}, {"w": "with", "t": 20.645}, {"w": "pros", "t": 21.005}, {"w": "and", "t": 21.365}, {"w": "cons.", "t": 21.67}], "lines": [{"t": 0.5, "e": 3.05, "text": "I use AI as a sparring partner."}, {"t": 3.35, "e": 8.025, "text": "For my projects, for decisions, for everything I'm stuck on."}, {"t": 8.925, "e": 13.465, "text": "And for a long time, every conversation went the same way."}, {"t": 13.765, "e": 15.51, "text": "I describe a problem."}, {"t": 15.81, "e": 17.39, "text": "And I get options."}, {"t": 17.69, "e": 18.715, "text": "Five ideas."}, {"t": 19.015, "e": 19.985, "text": "Ten ideas."}, {"t": 20.285, "e": 22.28, "text": "Each with pros and cons."}], "start": 36.8}, {"id": "2.04", "section": 2, "section_title": "Solutions first", "kind": "anim", "desc": "picking feels like progress", "key": "picking-feels-like-progress", "title": null, "stage": null, "pieces": [], "dur": 17.5667, "words": [{"w": "And", "t": 0.5}, {"w": "it", "t": 0.805}, {"w": "feels", "t": 1.055}, {"w": "great.", "t": 1.47}, {"w": "I", "t": 2.435}, {"w": "read", "t": 2.63}, {"w": "them,", "t": 2.99}, {"w": "I", "t": 3.57}, {"w": "pick", "t": 3.765}, {"w": "one,", "t": 4.125}, {"w": "I", "t": 4.65}, {"w": "ask", "t": 4.845}, {"w": "for", "t": 5.15}, {"w": "more.", "t": 5.455}, {"w": "It", "t": 6.365}, {"w": "feels", "t": 6.615}, {"w": "like", "t": 7.03}, {"w": "progress.", "t": 7.39}, {"w": "But", "t": 9.12}, {"w": "after", "t": 9.425}, {"w": "an", "t": 9.84}, {"w": "hour", "t": 10.09}, {"w": "I", "t": 10.45}, {"w": "often", "t": 10.645}, {"w": "had", "t": 11.06}, {"w": "a", "t": 11.365}, {"w": "long", "t": 11.56}, {"w": "list,", "t": 11.92}, {"w": "and", "t": 12.5}, {"w": "no", "t": 12.805}, {"w": "idea", "t": 13.055}, {"w": "whether", "t": 13.415}, {"w": "any", "t": 13.94}, {"w": "of", "t": 14.245}, {"w": "it", "t": 14.495}, {"w": "was", "t": 14.745}, {"w": "what", "t": 15.05}, {"w": "I", "t": 15.41}, {"w": "actually", "t": 15.605}, {"w": "wanted.", "t": 16.185}], "lines": [{"t": 0.5, "e": 2.135, "text": "And it feels great."}, {"t": 2.435, "e": 6.065, "text": "I read them, I pick one, I ask for more."}, {"t": 6.365, "e": 8.22, "text": "It feels like progress."}, {"t": 9.12, "e": 16.905, "text": "But after an hour I often had a long list, and no idea whether any of it was what I actually wanted."}], "start": 59.7333}, {"id": "2.05", "section": 2, "section_title": "Solutions first", "kind": "anim", "desc": "don't jump into suggestions", "key": "don-t-jump-into-suggestions", "title": null, "stage": null, "pieces": [], "dur": 19.4667, "words": [{"w": "So", "t": 0.5}, {"w": "my", "t": 0.75}, {"w": "first", "t": 1.0}, {"w": "reaction", "t": 1.415}, {"w": "was", "t": 1.995}, {"w": "simple.", "t": 2.3}, {"w": "I", "t": 3.32}, {"w": "told", "t": 3.515}, {"w": "it:", "t": 3.875}, {"w": "don't", "t": 4.675}, {"w": "jump", "t": 5.035}, {"w": "into", "t": 5.395}, {"w": "suggestions.", "t": 5.755}, {"w": "First", "t": 7.05}, {"w": "help", "t": 7.465}, {"w": "me", "t": 7.825}, {"w": "understand", "t": 8.075}, {"w": "the", "t": 8.765}, {"w": "problem.", "t": 9.07}, {"w": "Ask", "t": 10.145}, {"w": "me", "t": 10.45}, {"w": "questions", "t": 10.7}, {"w": "instead.", "t": 11.335}, {"w": "That", "t": 13.01}, {"w": "alone", "t": 13.37}, {"w": "helped", "t": 13.785}, {"w": "a", "t": 14.255}, {"w": "lot.", "t": 14.45}, {"w": "The", "t": 15.305}, {"w": "conversations", "t": 15.61}, {"w": "got", "t": 16.465}, {"w": "slower.", "t": 16.77}, {"w": "And", "t": 17.79}, {"w": "better.", "t": 18.095}], "lines": [{"t": 0.5, "e": 3.02, "text": "So my first reaction was simple."}, {"t": 3.32, "e": 4.375, "text": "I told it:"}, {"t": 4.675, "e": 6.75, "text": "don't jump into suggestions."}, {"t": 7.05, "e": 9.845, "text": "First help me understand the problem."}, {"t": 10.145, "e": 12.11, "text": "Ask me questions instead."}, {"t": 13.01, "e": 15.005, "text": "That alone helped a lot."}, {"t": 15.305, "e": 17.49, "text": "The conversations got slower."}, {"t": 17.79, "e": 18.815, "text": "And better."}], "start": 77.3}, {"id": "3.06", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "The five stages", "key": "card", "title": "The five stages", "stage": null, "pieces": [], "dur": 3.5, "words": [], "lines": [], "start": 96.7667}, {"id": "3.07", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "five lines on the page", "key": "five-lines-on-the-page", "title": null, "stage": null, "pieces": [], "dur": 38.8667, "words": [{"w": "Then", "t": 0.5}, {"w": "I", "t": 0.86}, {"w": "came", "t": 1.055}, {"w": "across", "t": 1.415}, {"w": "a", "t": 1.885}, {"w": "model", "t": 2.08}, {"w": "from", "t": 2.495}, {"w": "Getting", "t": 2.855}, {"w": "Things", "t": 3.38}, {"w": "Done,", "t": 3.85}, {"w": "a", "t": 4.43}, {"w": "book", "t": 4.625}, {"w": "by", "t": 4.985}, {"w": "David", "t": 5.235}, {"w": "Allen.", "t": 5.65}, {"w": "He", "t": 6.615}, {"w": "describes", "t": 6.865}, {"w": "how", "t": 7.5}, {"w": "our", "t": 7.805}, {"w": "mind", "t": 8.11}, {"w": "plans,", "t": 8.47}, {"w": "when", "t": 9.105}, {"w": "it", "t": 9.465}, {"w": "plans", "t": 9.715}, {"w": "well.", "t": 10.13}, {"w": "Five", "t": 11.04}, {"w": "stages.", "t": 11.4}, {"w": "Purpose.", "t": 13.02}, {"w": "Why", "t": 14.095}, {"w": "am", "t": 14.4}, {"w": "I", "t": 14.65}, {"w": "doing", "t": 14.845}, {"w": "this?", "t": 15.26}, {"w": "Vision.", "t": 16.77}, {"w": "What", "t": 17.79}, {"w": "does", "t": 18.15}, {"w": "it", "t": 18.51}, {"w": "look", "t": 18.76}, {"w": "like", "t": 19.12}, {"w": "when", "t": 19.48}, {"w": "it", "t": 19.84}, {"w": "worked?", "t": 20.09}, {"w": "Brainstorming.", "t": 21.71}, {"w": "Everything", "t": 23.115}, {"w": "that", "t": 23.805}, {"w": "comes", "t": 24.165}, {"w": "to", "t": 24.58}, {"w": "mind,", "t": 24.83}, {"w": "without", "t": 25.41}, {"w": "judging.", "t": 25.935}, {"w": "Organising.", "t": 27.61}, {"w": "Giving", "t": 28.85}, {"w": "the", "t": 29.32}, {"w": "pile", "t": 29.625}, {"w": "a", "t": 29.985}, {"w": "shape.", "t": 30.18}, {"w": "And", "t": 31.745}, {"w": "next", "t": 32.05}, {"w": "actions.", "t": 32.41}, {"w": "What", "t": 33.485}, {"w": "is", "t": 33.845}, {"w": "the", "t": 34.095}, {"w": "very", "t": 34.4}, {"w": "next", "t": 34.76}, {"w": "thing", "t": 35.12}, {"w": "I", "t": 35.535}, {"w": "do?", "t": 35.73}], "lines": [{"t": 0.5, "e": 6.315, "text": "Then I came across a model from Getting Things Done, a book by David Allen."}, {"t": 6.615, "e": 10.74, "text": "He describes how our mind plans, when it plans well."}, {"t": 11.04, "e": 12.12, "text": "Five stages."}, {"t": 13.02, "e": 13.795, "text": "Purpose."}, {"t": 14.095, "e": 15.87, "text": "Why am I doing this?"}, {"t": 16.77, "e": 17.49, "text": "Vision."}, {"t": 17.79, "e": 20.81, "text": "What does it look like when it worked?"}, {"t": 21.71, "e": 22.815, "text": "Brainstorming."}, {"t": 23.115, "e": 26.71, "text": "Everything that comes to mind, without judging."}, {"t": 27.61, "e": 28.55, "text": "Organising."}, {"t": 28.85, "e": 30.845, "text": "Giving the pile a shape."}, {"t": 31.745, "e": 33.185, "text": "And next actions."}, {"t": 33.485, "e": 36.23, "text": "What is the very next thing I do?"}], "start": 100.2667}, {"id": "3.08", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "we start in the middle", "key": "we-start-in-the-middle", "title": null, "stage": null, "pieces": [], "dur": 21.6333, "words": [{"w": "Allen", "t": 0.5}, {"w": "says", "t": 0.915}, {"w": "we", "t": 1.275}, {"w": "do", "t": 1.525}, {"w": "this", "t": 1.775}, {"w": "naturally", "t": 2.135}, {"w": "for", "t": 2.77}, {"w": "small", "t": 3.075}, {"w": "things,", "t": 3.49}, {"w": "like", "t": 4.18}, {"w": "going", "t": 4.54}, {"w": "out", "t": 4.955}, {"w": "for", "t": 5.26}, {"w": "dinner.", "t": 5.565}, {"w": "But", "t": 6.585}, {"w": "as", "t": 6.89}, {"w": "soon", "t": 7.14}, {"w": "as", "t": 7.5}, {"w": "something", "t": 7.75}, {"w": "feels", "t": 8.385}, {"w": "important,", "t": 8.8}, {"w": "we", "t": 9.655}, {"w": "skip", "t": 9.905}, {"w": "the", "t": 10.265}, {"w": "first", "t": 10.57}, {"w": "stages.", "t": 10.985}, {"w": "We", "t": 12.005}, {"w": "start", "t": 12.255}, {"w": "in", "t": 12.67}, {"w": "the", "t": 12.92}, {"w": "middle,", "t": 13.225}, {"w": "with", "t": 13.915}, {"w": "organising", "t": 14.275}, {"w": "and", "t": 14.965}, {"w": "solutions,", "t": 15.27}, {"w": "because", "t": 16.125}, {"w": "that", "t": 16.65}, {"w": "feels", "t": 17.01}, {"w": "productive.", "t": 17.425}, {"w": "He", "t": 18.665}, {"w": "calls", "t": 18.915}, {"w": "it", "t": 19.33}, {"w": "reactive", "t": 19.58}, {"w": "planning.", "t": 20.16}], "lines": [{"t": 0.5, "e": 6.285, "text": "Allen says we do this naturally for small things, like going out for dinner."}, {"t": 6.585, "e": 11.705, "text": "But as soon as something feels important, we skip the first stages."}, {"t": 12.005, "e": 18.365, "text": "We start in the middle, with organising and solutions, because that feels productive."}, {"t": 18.665, "e": 20.99, "text": "He calls it reactive planning."}], "start": 139.1334}, {"id": "3.09", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "example, the question", "key": "example-the-question", "title": null, "stage": 4.0, "pieces": [], "dur": 20.5667, "words": [{"w": "Here's", "t": 0.5}, {"w": "an", "t": 0.915}, {"w": "example.", "t": 1.165}, {"w": "Say", "t": 2.24}, {"w": "you", "t": 2.545}, {"w": "run", "t": 2.85}, {"w": "a", "t": 3.155}, {"w": "student", "t": 3.35}, {"w": "group,", "t": 3.875}, {"w": "and", "t": 4.51}, {"w": "too", "t": 4.815}, {"w": "few", "t": 5.12}, {"w": "people", "t": 5.425}, {"w": "come", "t": 5.895}, {"w": "to", "t": 6.255}, {"w": "your", "t": 6.505}, {"w": "meetings.", "t": 6.865}, {"w": "So", "t": 7.995}, {"w": "you", "t": 8.245}, {"w": "ask:", "t": 8.55}, {"w": "how", "t": 9.405}, {"w": "do", "t": 9.71}, {"w": "we", "t": 9.96}, {"w": "get", "t": 10.21}, {"w": "more", "t": 10.515}, {"w": "people?", "t": 10.875}, {"w": "You'll", "t": 12.495}, {"w": "get", "t": 12.91}, {"w": "posters.", "t": 13.215}, {"w": "Instagram.", "t": 14.29}, {"w": "Free", "t": 15.475}, {"w": "pizza.", "t": 15.835}, {"w": "A", "t": 16.8}, {"w": "stall", "t": 16.995}, {"w": "on", "t": 17.41}, {"w": "campus.", "t": 17.66}, {"w": "All", "t": 18.68}, {"w": "reasonable.", "t": 18.985}], "lines": [{"t": 0.5, "e": 1.94, "text": "Here's an example."}, {"t": 2.24, "e": 7.695, "text": "Say you run a student group, and too few people come to your meetings."}, {"t": 7.995, "e": 9.105, "text": "So you ask:"}, {"t": 9.405, "e": 11.595, "text": "how do we get more people?"}, {"t": 12.495, "e": 13.99, "text": "You'll get posters."}, {"t": 14.29, "e": 15.175, "text": "Instagram."}, {"t": 15.475, "e": 16.5, "text": "Free pizza."}, {"t": 16.8, "e": 18.38, "text": "A stall on campus."}, {"t": 18.68, "e": 19.925, "text": "All reasonable."}], "start": 160.7667}, {"id": "3.10", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "example, purpose", "key": "example-purpose", "title": null, "stage": 1.0, "pieces": [], "dur": 32.1, "words": [{"w": "Now", "t": 0.5}, {"w": "start", "t": 0.805}, {"w": "at", "t": 1.22}, {"w": "the", "t": 1.47}, {"w": "top", "t": 1.775}, {"w": "instead.", "t": 2.08}, {"w": "Why", "t": 3.155}, {"w": "do", "t": 3.46}, {"w": "you", "t": 3.71}, {"w": "want", "t": 4.015}, {"w": "more", "t": 4.375}, {"w": "people?", "t": 4.735}, {"w": "Maybe", "t": 5.755}, {"w": "the", "t": 6.17}, {"w": "honest", "t": 6.475}, {"w": "answer", "t": 6.945}, {"w": "is:", "t": 7.415}, {"w": "because", "t": 8.215}, {"w": "three", "t": 8.74}, {"w": "of", "t": 9.155}, {"w": "us", "t": 9.405}, {"w": "do", "t": 9.655}, {"w": "all", "t": 9.905}, {"w": "the", "t": 10.21}, {"w": "work,", "t": 10.515}, {"w": "and", "t": 11.095}, {"w": "we're", "t": 11.4}, {"w": "tired.", "t": 11.76}, {"w": "Why", "t": 12.725}, {"w": "does", "t": 13.03}, {"w": "that", "t": 13.39}, {"w": "matter?", "t": 13.75}, {"w": "Because", "t": 14.77}, {"w": "otherwise", "t": 15.295}, {"w": "the", "t": 15.93}, {"w": "group", "t": 16.235}, {"w": "dies", "t": 16.65}, {"w": "when", "t": 17.01}, {"w": "we", "t": 17.37}, {"w": "leave.", "t": 17.62}, {"w": "Look", "t": 19.185}, {"w": "what", "t": 19.545}, {"w": "happened.", "t": 19.905}, {"w": "You", "t": 21.035}, {"w": "don't", "t": 21.34}, {"w": "need", "t": 21.7}, {"w": "more", "t": 22.06}, {"w": "people", "t": 22.42}, {"w": "at", "t": 22.89}, {"w": "meetings.", "t": 23.14}, {"w": "You", "t": 24.27}, {"w": "need", "t": 24.575}, {"w": "two", "t": 24.935}, {"w": "or", "t": 25.24}, {"w": "three", "t": 25.49}, {"w": "who", "t": 25.905}, {"w": "take", "t": 26.21}, {"w": "over", "t": 26.57}, {"w": "real", "t": 26.93}, {"w": "work.", "t": 27.29}, {"w": "Posters", "t": 28.2}, {"w": "and", "t": 28.725}, {"w": "pizza", "t": 29.03}, {"w": "just", "t": 29.445}, {"w": "fell", "t": 29.805}, {"w": "off", "t": 30.165}, {"w": "the", "t": 30.47}, {"w": "table.", "t": 30.775}], "lines": [{"t": 0.5, "e": 2.855, "text": "Now start at the top instead."}, {"t": 3.155, "e": 5.455, "text": "Why do you want more people?"}, {"t": 5.755, "e": 7.915, "text": "Maybe the honest answer is:"}, {"t": 8.215, "e": 12.425, "text": "because three of us do all the work, and we're tired."}, {"t": 12.725, "e": 14.47, "text": "Why does that matter?"}, {"t": 14.77, "e": 18.285, "text": "Because otherwise the group dies when we leave."}, {"t": 19.185, "e": 20.735, "text": "Look what happened."}, {"t": 21.035, "e": 23.97, "text": "You don't need more people at meetings."}, {"t": 24.27, "e": 27.9, "text": "You need two or three who take over real work."}, {"t": 28.2, "e": 31.44, "text": "Posters and pizza just fell off the table."}], "start": 181.3334}, {"id": "3.11", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "example, vision", "key": "example-vision", "title": null, "stage": 2.0, "pieces": [], "dur": 18.8333, "words": [{"w": "Then", "t": 0.5}, {"w": "the", "t": 0.86}, {"w": "vision.", "t": 1.165}, {"w": "Assume", "t": 2.185}, {"w": "it", "t": 2.655}, {"w": "worked.", "t": 2.905}, {"w": "What", "t": 3.925}, {"w": "do", "t": 4.285}, {"w": "you", "t": 4.535}, {"w": "see?", "t": 4.84}, {"w": "Not", "t": 5.695}, {"w": "\"the", "t": 6.0}, {"w": "group", "t": 6.305}, {"w": "is", "t": 6.72}, {"w": "doing", "t": 6.97}, {"w": "well\".", "t": 7.385}, {"w": "Something", "t": 8.295}, {"w": "specific", "t": 8.93}, {"w": "enough", "t": 9.51}, {"w": "to", "t": 9.98}, {"w": "be", "t": 10.23}, {"w": "wrong.", "t": 10.48}, {"w": "A", "t": 11.445}, {"w": "Tuesday", "t": 11.64}, {"w": "in", "t": 12.165}, {"w": "June,", "t": 12.415}, {"w": "and", "t": 12.995}, {"w": "someone", "t": 13.3}, {"w": "else", "t": 13.825}, {"w": "is", "t": 14.185}, {"w": "running", "t": 14.435}, {"w": "the", "t": 14.96}, {"w": "meeting,", "t": 15.265}, {"w": "while", "t": 16.01}, {"w": "you", "t": 16.425}, {"w": "sit", "t": 16.73}, {"w": "in", "t": 17.035}, {"w": "the", "t": 17.285}, {"w": "back.", "t": 17.59}], "lines": [{"t": 0.5, "e": 1.885, "text": "Then the vision."}, {"t": 2.185, "e": 3.625, "text": "Assume it worked."}, {"t": 3.925, "e": 5.395, "text": "What do you see?"}, {"t": 5.695, "e": 7.995, "text": "Not \"the group is doing well\"."}, {"t": 8.295, "e": 11.145, "text": "Something specific enough to be wrong."}, {"t": 11.445, "e": 18.2, "text": "A Tuesday in June, and someone else is running the meeting, while you sit in the back."}], "start": 213.4334}, {"id": "3.12", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "example, brainstorm and organise", "key": "example-brainstorm-and-organise", "title": null, "stage": 3.0, "pieces": [], "dur": 14.3, "words": [{"w": "Only", "t": 0.5}, {"w": "now", "t": 0.86}, {"w": "you", "t": 1.165}, {"w": "brainstorm.", "t": 1.47}, {"w": "And", "t": 2.71}, {"w": "the", "t": 3.015}, {"w": "ideas", "t": 3.32}, {"w": "are", "t": 3.735}, {"w": "different,", "t": 4.04}, {"w": "because", "t": 4.895}, {"w": "they", "t": 5.42}, {"w": "know", "t": 5.78}, {"w": "where", "t": 6.14}, {"w": "they're", "t": 6.555}, {"w": "going.", "t": 7.025}, {"w": "Then", "t": 8.59}, {"w": "you", "t": 8.95}, {"w": "sort", "t": 9.255}, {"w": "them:", "t": 9.615}, {"w": "what", "t": 10.525}, {"w": "belongs", "t": 10.885}, {"w": "together,", "t": 11.41}, {"w": "what", "t": 12.21}, {"w": "comes", "t": 12.57}, {"w": "first.", "t": 12.985}], "lines": [{"t": 0.5, "e": 2.41, "text": "Only now you brainstorm."}, {"t": 2.71, "e": 7.69, "text": "And the ideas are different, because they know where they're going."}, {"t": 8.59, "e": 10.225, "text": "Then you sort them:"}, {"t": 10.525, "e": 13.65, "text": "what belongs together, what comes first."}], "start": 232.2667}, {"id": "3.13", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "example, next action", "key": "example-next-action", "title": null, "stage": 5.0, "pieces": [], "dur": 16.1, "words": [{"w": "And", "t": 0.5}, {"w": "at", "t": 0.805}, {"w": "the", "t": 1.055}, {"w": "end,", "t": 1.36}, {"w": "one", "t": 1.885}, {"w": "next", "t": 2.19}, {"w": "action.", "t": 2.55}, {"w": "Something", "t": 3.57}, {"w": "so", "t": 4.205}, {"w": "concrete", "t": 4.455}, {"w": "that", "t": 5.035}, {"w": "somebody", "t": 5.395}, {"w": "else", "t": 5.975}, {"w": "could", "t": 6.335}, {"w": "do", "t": 6.75}, {"w": "it", "t": 7.0}, {"w": "without", "t": 7.25}, {"w": "deciding", "t": 7.775}, {"w": "anything.", "t": 8.355}, {"w": "Write", "t": 9.485}, {"w": "to", "t": 9.9}, {"w": "one", "t": 10.15}, {"w": "person,", "t": 10.455}, {"w": "and", "t": 11.145}, {"w": "ask", "t": 11.45}, {"w": "if", "t": 11.755}, {"w": "she", "t": 12.005}, {"w": "wants", "t": 12.31}, {"w": "to", "t": 12.725}, {"w": "plan", "t": 12.975}, {"w": "the", "t": 13.335}, {"w": "next", "t": 13.64}, {"w": "meeting", "t": 14.0}, {"w": "with", "t": 14.525}, {"w": "you.", "t": 14.885}], "lines": [{"t": 0.5, "e": 3.27, "text": "And at the end, one next action."}, {"t": 3.57, "e": 9.185, "text": "Something so concrete that somebody else could do it without deciding anything."}, {"t": 9.485, "e": 15.44, "text": "Write to one person, and ask if she wants to plan the next meeting with you."}], "start": 246.5667}, {"id": "3.14", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "the file between us", "key": "the-file-between-us", "title": null, "stage": null, "pieces": [], "dur": 19.9, "words": [{"w": "I", "t": 0.5}, {"w": "wrote", "t": 0.695}, {"w": "these", "t": 1.11}, {"w": "five", "t": 1.525}, {"w": "stages", "t": 1.885}, {"w": "into", "t": 2.355}, {"w": "one", "t": 2.715}, {"w": "file,", "t": 3.02}, {"w": "and", "t": 3.6}, {"w": "told", "t": 3.905}, {"w": "my", "t": 4.265}, {"w": "AI:", "t": 4.515}, {"w": "this", "t": 5.315}, {"w": "is", "t": 5.675}, {"w": "how", "t": 5.925}, {"w": "we", "t": 6.23}, {"w": "think", "t": 6.48}, {"w": "together.", "t": 6.895}, {"w": "Stay", "t": 8.025}, {"w": "in", "t": 8.385}, {"w": "a", "t": 8.635}, {"w": "stage", "t": 8.83}, {"w": "until", "t": 9.245}, {"w": "I", "t": 9.66}, {"w": "move", "t": 9.855}, {"w": "on.", "t": 10.215}, {"w": "And", "t": 11.015}, {"w": "if", "t": 11.32}, {"w": "I'm", "t": 11.57}, {"w": "stuck,", "t": 11.82}, {"w": "point", "t": 12.455}, {"w": "me", "t": 12.87}, {"w": "back", "t": 13.12}, {"w": "up.", "t": 13.48}, {"w": "I", "t": 14.88}, {"w": "expected", "t": 15.075}, {"w": "a", "t": 15.655}, {"w": "small", "t": 15.85}, {"w": "improvement.", "t": 16.265}, {"w": "It", "t": 17.56}, {"w": "was", "t": 17.81}, {"w": "another", "t": 18.115}, {"w": "leap.", "t": 18.64}], "lines": [{"t": 0.5, "e": 5.015, "text": "I wrote these five stages into one file, and told my AI:"}, {"t": 5.315, "e": 7.725, "text": "this is how we think together."}, {"t": 8.025, "e": 10.715, "text": "Stay in a stage until I move on."}, {"t": 11.015, "e": 13.98, "text": "And if I'm stuck, point me back up."}, {"t": 14.88, "e": 17.26, "text": "I expected a small improvement."}, {"t": 17.56, "e": 19.25, "text": "It was another leap."}], "start": 262.6667}, {"id": "3.15", "section": 3, "section_title": "The five stages", "kind": "anim", "desc": "stuck, go one up", "key": "stuck-go-one-up", "title": null, "stage": null, "pieces": [], "dur": 22.8, "words": [{"w": "The", "t": 0.5}, {"w": "part", "t": 0.805}, {"w": "I", "t": 1.165}, {"w": "use", "t": 1.36}, {"w": "most", "t": 1.665}, {"w": "is", "t": 2.025}, {"w": "this.", "t": 2.275}, {"w": "When", "t": 3.185}, {"w": "something", "t": 3.545}, {"w": "is", "t": 4.18}, {"w": "stuck,", "t": 4.43}, {"w": "the", "t": 5.065}, {"w": "problem", "t": 5.37}, {"w": "is", "t": 5.895}, {"w": "usually", "t": 6.145}, {"w": "one", "t": 6.67}, {"w": "stage", "t": 6.975}, {"w": "higher.", "t": 7.39}, {"w": "No", "t": 8.41}, {"w": "ideas?", "t": 8.66}, {"w": "The", "t": 9.625}, {"w": "vision", "t": 9.93}, {"w": "isn't", "t": 10.4}, {"w": "vivid", "t": 10.76}, {"w": "enough.", "t": 11.175}, {"w": "Vision", "t": 12.195}, {"w": "vague?", "t": 12.665}, {"w": "The", "t": 13.63}, {"w": "purpose", "t": 13.935}, {"w": "isn't", "t": 14.46}, {"w": "clear.", "t": 14.82}, {"w": "And", "t": 15.785}, {"w": "when", "t": 16.09}, {"w": "everything", "t": 16.45}, {"w": "is", "t": 17.14}, {"w": "too", "t": 17.39}, {"w": "much,", "t": 17.695}, {"w": "go", "t": 18.275}, {"w": "all", "t": 18.525}, {"w": "the", "t": 18.83}, {"w": "way", "t": 19.135}, {"w": "down:", "t": 19.44}, {"w": "what's", "t": 20.35}, {"w": "the", "t": 20.765}, {"w": "next", "t": 21.07}, {"w": "action?", "t": 21.43}], "lines": [{"t": 0.5, "e": 2.885, "text": "The part I use most is this."}, {"t": 3.185, "e": 8.11, "text": "When something is stuck, the problem is usually one stage higher."}, {"t": 8.41, "e": 9.325, "text": "No ideas?"}, {"t": 9.625, "e": 11.895, "text": "The vision isn't vivid enough."}, {"t": 12.195, "e": 13.33, "text": "Vision vague?"}, {"t": 13.63, "e": 15.485, "text": "The purpose isn't clear."}, {"t": 15.785, "e": 20.05, "text": "And when everything is too much, go all the way down:"}, {"t": 20.35, "e": 22.15, "text": "what's the next action?"}], "start": 282.5667}, {"id": "4.16", "section": 4, "section_title": "Goal and steps", "kind": "anim", "desc": "Goal and steps", "key": "card", "title": "Goal and steps", "stage": null, "pieces": [], "dur": 3.5, "words": [], "lines": [], "start": 305.3667}, {"id": "4.17", "section": 4, "section_title": "Goal and steps", "kind": "anim", "desc": "a goal and steps", "key": "a-goal-and-steps", "title": null, "stage": null, "pieces": [], "dur": 24.1333, "words": [{"w": "So", "t": 0.5}, {"w": "why", "t": 0.75}, {"w": "does", "t": 1.055}, {"w": "one", "t": 1.415}, {"w": "page", "t": 1.72}, {"w": "change", "t": 2.08}, {"w": "so", "t": 2.55}, {"w": "much?", "t": 2.8}, {"w": "Here's", "t": 3.71}, {"w": "what", "t": 4.125}, {"w": "I", "t": 4.485}, {"w": "think.", "t": 4.68}, {"w": "All", "t": 6.245}, {"w": "strategy", "t": 6.55}, {"w": "is", "t": 7.13}, {"w": "really", "t": 7.38}, {"w": "one", "t": 7.85}, {"w": "thing:", "t": 8.155}, {"w": "connecting", "t": 9.12}, {"w": "a", "t": 9.81}, {"w": "goal", "t": 10.005}, {"w": "you", "t": 10.365}, {"w": "have", "t": 10.67}, {"w": "with", "t": 11.03}, {"w": "steps", "t": 11.39}, {"w": "you", "t": 11.805}, {"w": "can", "t": 12.11}, {"w": "take.", "t": 12.415}, {"w": "And", "t": 13.925}, {"w": "humans", "t": 14.23}, {"w": "are", "t": 14.7}, {"w": "very", "t": 15.005}, {"w": "bad", "t": 15.365}, {"w": "at", "t": 15.67}, {"w": "one", "t": 15.92}, {"w": "half", "t": 16.225}, {"w": "of", "t": 16.585}, {"w": "that.", "t": 16.835}, {"w": "Not", "t": 17.745}, {"w": "at", "t": 18.05}, {"w": "finding", "t": 18.3}, {"w": "steps.", "t": 18.825}, {"w": "At", "t": 19.79}, {"w": "keeping", "t": 20.04}, {"w": "the", "t": 20.565}, {"w": "goal", "t": 20.87}, {"w": "in", "t": 21.23}, {"w": "mind", "t": 21.48}, {"w": "while", "t": 21.84}, {"w": "we", "t": 22.255}, {"w": "take", "t": 22.505}, {"w": "them.", "t": 22.865}], "lines": [{"t": 0.5, "e": 3.41, "text": "So why does one page change so much?"}, {"t": 3.71, "e": 5.345, "text": "Here's what I think."}, {"t": 6.245, "e": 8.82, "text": "All strategy is really one thing:"}, {"t": 9.12, "e": 13.025, "text": "connecting a goal you have with steps you can take."}, {"t": 13.925, "e": 17.445, "text": "And humans are very bad at one half of that."}, {"t": 17.745, "e": 19.49, "text": "Not at finding steps."}, {"t": 19.79, "e": 23.475, "text": "At keeping the goal in mind while we take them."}], "start": 308.8667}, {"id": "4.18", "section": 4, "section_title": "Goal and steps", "kind": "anim", "desc": "the goal fades", "key": "the-goal-fades", "title": null, "stage": null, "pieces": [], "dur": 15.4, "words": [{"w": "We", "t": 0.5}, {"w": "start", "t": 0.75}, {"w": "with", "t": 1.165}, {"w": "a", "t": 1.525}, {"w": "reason.", "t": 1.72}, {"w": "Then", "t": 2.74}, {"w": "we", "t": 3.1}, {"w": "get", "t": 3.35}, {"w": "busy.", "t": 3.655}, {"w": "Each", "t": 4.565}, {"w": "step", "t": 4.925}, {"w": "makes", "t": 5.285}, {"w": "sense", "t": 5.7}, {"w": "after", "t": 6.115}, {"w": "the", "t": 6.53}, {"w": "one", "t": 6.835}, {"w": "before.", "t": 7.14}, {"w": "And", "t": 8.16}, {"w": "slowly", "t": 8.465}, {"w": "the", "t": 8.935}, {"w": "reason", "t": 9.24}, {"w": "we", "t": 9.71}, {"w": "started", "t": 9.96}, {"w": "fades,", "t": 10.485}, {"w": "and", "t": 11.12}, {"w": "we", "t": 11.425}, {"w": "don't", "t": 11.675}, {"w": "notice,", "t": 12.035}, {"w": "because", "t": 12.725}, {"w": "we're", "t": 13.25}, {"w": "still", "t": 13.61}, {"w": "moving.", "t": 14.025}], "lines": [{"t": 0.5, "e": 2.44, "text": "We start with a reason."}, {"t": 2.74, "e": 4.265, "text": "Then we get busy."}, {"t": 4.565, "e": 7.86, "text": "Each step makes sense after the one before."}, {"t": 8.16, "e": 14.745, "text": "And slowly the reason we started fades, and we don't notice, because we're still moving."}], "start": 333.0}, {"id": "4.19", "section": 4, "section_title": "Goal and steps", "kind": "anim", "desc": "the stages hold the thread", "key": "the-stages-hold-the-thread", "title": null, "stage": null, "pieces": [], "dur": 16.0, "words": [{"w": "The", "t": 0.5}, {"w": "five", "t": 0.805}, {"w": "stages", "t": 1.165}, {"w": "are", "t": 1.635}, {"w": "nothing", "t": 1.94}, {"w": "more", "t": 2.465}, {"w": "than", "t": 2.825}, {"w": "a", "t": 3.185}, {"w": "way", "t": 3.38}, {"w": "to", "t": 3.685}, {"w": "hold", "t": 3.935}, {"w": "that", "t": 4.295}, {"w": "thread.", "t": 4.655}, {"w": "Every", "t": 5.675}, {"w": "stage", "t": 6.09}, {"w": "is", "t": 6.505}, {"w": "tied", "t": 6.755}, {"w": "to", "t": 7.115}, {"w": "the", "t": 7.365}, {"w": "one", "t": 7.67}, {"w": "above", "t": 7.975}, {"w": "it.", "t": 8.39}, {"w": "The", "t": 9.19}, {"w": "action", "t": 9.495}, {"w": "belongs", "t": 9.965}, {"w": "to", "t": 10.49}, {"w": "a", "t": 10.74}, {"w": "plan,", "t": 10.935}, {"w": "the", "t": 11.515}, {"w": "plan", "t": 11.82}, {"w": "to", "t": 12.18}, {"w": "a", "t": 12.43}, {"w": "picture,", "t": 12.625}, {"w": "the", "t": 13.37}, {"w": "picture", "t": 13.675}, {"w": "to", "t": 14.2}, {"w": "a", "t": 14.45}, {"w": "reason.", "t": 14.645}], "lines": [{"t": 0.5, "e": 5.375, "text": "The five stages are nothing more than a way to hold that thread."}, {"t": 5.675, "e": 8.89, "text": "Every stage is tied to the one above it."}, {"t": 9.19, "e": 15.365, "text": "The action belongs to a plan, the plan to a picture, the picture to a reason."}], "start": 348.4}, {"id": "4.20", "section": 4, "section_title": "Goal and steps", "kind": "anim", "desc": "the AI jumps too", "key": "the-ai-jumps-too", "title": null, "stage": null, "pieces": [], "dur": 21.6, "words": [{"w": "And", "t": 0.5}, {"w": "here's", "t": 0.805}, {"w": "what", "t": 1.22}, {"w": "I", "t": 1.58}, {"w": "find", "t": 1.775}, {"w": "most", "t": 2.135}, {"w": "interesting.", "t": 2.495}, {"w": "The", "t": 3.79}, {"w": "AI", "t": 4.095}, {"w": "makes", "t": 4.345}, {"w": "the", "t": 4.76}, {"w": "same", "t": 5.065}, {"w": "mistake.", "t": 5.425}, {"w": "It", "t": 6.5}, {"w": "also", "t": 6.75}, {"w": "jumps", "t": 7.11}, {"w": "to", "t": 7.525}, {"w": "solutions.", "t": 7.775}, {"w": "I", "t": 9.56}, {"w": "suspect", "t": 9.755}, {"w": "it", "t": 10.28}, {"w": "learned", "t": 10.53}, {"w": "that", "t": 11.055}, {"w": "from", "t": 11.415}, {"w": "us.", "t": 11.775}, {"w": "We", "t": 12.575}, {"w": "experience", "t": 12.825}, {"w": "a", "t": 13.515}, {"w": "list", "t": 13.71}, {"w": "of", "t": 14.07}, {"w": "options", "t": 14.32}, {"w": "as", "t": 14.845}, {"w": "helpful.", "t": 15.095}, {"w": "So", "t": 16.17}, {"w": "that's", "t": 16.42}, {"w": "what", "t": 16.835}, {"w": "it", "t": 17.195}, {"w": "gives", "t": 17.445}, {"w": "us.", "t": 17.86}, {"w": "Reactive", "t": 18.66}, {"w": "planning,", "t": 19.24}, {"w": "at", "t": 20.04}, {"w": "scale.", "t": 20.29}], "lines": [{"t": 0.5, "e": 3.49, "text": "And here's what I find most interesting."}, {"t": 3.79, "e": 6.2, "text": "The AI makes the same mistake."}, {"t": 6.5, "e": 8.66, "text": "It also jumps to solutions."}, {"t": 9.56, "e": 12.275, "text": "I suspect it learned that from us."}, {"t": 12.575, "e": 15.87, "text": "We experience a list of options as helpful."}, {"t": 16.17, "e": 18.36, "text": "So that's what it gives us."}, {"t": 18.66, "e": 20.955, "text": "Reactive planning, at scale."}], "start": 364.4}, {"id": "5.21", "section": 5, "section_title": "The supervisor", "kind": "anim", "desc": "The supervisor", "key": "card", "title": "The supervisor", "stage": null, "pieces": [], "dur": 3.5, "words": [], "lines": [], "start": 386.0}, {"id": "5.22", "section": 5, "section_title": "The supervisor", "kind": "anim", "desc": "the supervisor", "key": "the-supervisor", "title": null, "stage": null, "pieces": [], "dur": 35.2, "words": [{"w": "I", "t": 0.5}, {"w": "think", "t": 0.695}, {"w": "there's", "t": 1.11}, {"w": "something", "t": 1.58}, {"w": "deeper", "t": 2.215}, {"w": "underneath.", "t": 2.685}, {"w": "This", "t": 3.925}, {"w": "part", "t": 4.285}, {"w": "is", "t": 4.645}, {"w": "speculation.", "t": 4.895}, {"w": "Most", "t": 6.79}, {"w": "of", "t": 7.15}, {"w": "what", "t": 7.4}, {"w": "our", "t": 7.76}, {"w": "mind", "t": 8.065}, {"w": "does", "t": 8.425}, {"w": "runs", "t": 8.785}, {"w": "by", "t": 9.145}, {"w": "itself.", "t": 9.395}, {"w": "Habits,", "t": 10.415}, {"w": "impulses,", "t": 11.105}, {"w": "the", "t": 11.905}, {"w": "next", "t": 12.21}, {"w": "obvious", "t": 12.57}, {"w": "step.", "t": 13.095}, {"w": "And", "t": 14.005}, {"w": "then", "t": 14.31}, {"w": "there's", "t": 14.67}, {"w": "a", "t": 15.14}, {"w": "small", "t": 15.335}, {"w": "part", "t": 15.75}, {"w": "that", "t": 16.11}, {"w": "watches.", "t": 16.47}, {"w": "That", "t": 17.545}, {"w": "checks:", "t": 17.905}, {"w": "does", "t": 18.925}, {"w": "this", "t": 19.285}, {"w": "still", "t": 19.645}, {"w": "fit", "t": 20.06}, {"w": "what", "t": 20.365}, {"w": "I", "t": 20.725}, {"w": "want?", "t": 20.92}, {"w": "Does", "t": 21.83}, {"w": "it", "t": 22.19}, {"w": "fit", "t": 22.44}, {"w": "what", "t": 22.745}, {"w": "I", "t": 23.105}, {"w": "believe?", "t": 23.3}, {"w": "Maybe", "t": 24.975}, {"w": "that's", "t": 25.39}, {"w": "a", "t": 25.805}, {"w": "big", "t": 26.0}, {"w": "part", "t": 26.305}, {"w": "of", "t": 26.665}, {"w": "what", "t": 26.915}, {"w": "intelligence", "t": 27.275}, {"w": "is.", "t": 28.075}, {"w": "Not", "t": 28.875}, {"w": "having", "t": 29.18}, {"w": "more", "t": 29.65}, {"w": "ideas.", "t": 30.01}, {"w": "Supervising", "t": 30.975}, {"w": "the", "t": 31.72}, {"w": "ones", "t": 32.025}, {"w": "that", "t": 32.385}, {"w": "come", "t": 32.745}, {"w": "up", "t": 33.105}, {"w": "by", "t": 33.355}, {"w": "themselves.", "t": 33.605}], "lines": [{"t": 0.5, "e": 3.625, "text": "I think there's something deeper underneath."}, {"t": 3.925, "e": 5.89, "text": "This part is speculation."}, {"t": 6.79, "e": 10.115, "text": "Most of what our mind does runs by itself."}, {"t": 10.415, "e": 13.705, "text": "Habits, impulses, the next obvious step."}, {"t": 14.005, "e": 17.245, "text": "And then there's a small part that watches."}, {"t": 17.545, "e": 18.625, "text": "That checks:"}, {"t": 18.925, "e": 21.53, "text": "does this still fit what I want?"}, {"t": 21.83, "e": 24.075, "text": "Does it fit what I believe?"}, {"t": 24.975, "e": 28.575, "text": "Maybe that's a big part of what intelligence is."}, {"t": 28.875, "e": 30.675, "text": "Not having more ideas."}, {"t": 30.975, "e": 34.545, "text": "Supervising the ones that come up by themselves."}], "start": 389.5}, {"id": "5.23", "section": 5, "section_title": "The supervisor", "kind": "anim", "desc": "the supervisor on a page", "key": "the-supervisor-on-a-page", "title": null, "stage": null, "pieces": [], "dur": 13.0333, "words": [{"w": "That", "t": 0.5}, {"w": "supervisor", "t": 0.86}, {"w": "is", "t": 1.55}, {"w": "weak,", "t": 1.8}, {"w": "and", "t": 2.38}, {"w": "it", "t": 2.685}, {"w": "gets", "t": 2.935}, {"w": "tired.", "t": 3.295}, {"w": "What", "t": 4.26}, {"w": "the", "t": 4.62}, {"w": "file", "t": 4.925}, {"w": "does", "t": 5.285}, {"w": "is", "t": 5.645}, {"w": "put", "t": 5.895}, {"w": "it", "t": 6.2}, {"w": "outside", "t": 6.45}, {"w": "my", "t": 6.975}, {"w": "head.", "t": 7.225}, {"w": "On", "t": 8.135}, {"w": "a", "t": 8.385}, {"w": "page.", "t": 8.58}, {"w": "Where", "t": 9.49}, {"w": "it", "t": 9.905}, {"w": "doesn't", "t": 10.155}, {"w": "forget", "t": 10.625}, {"w": "why", "t": 11.095}, {"w": "I", "t": 11.4}, {"w": "started.", "t": 11.595}], "lines": [{"t": 0.5, "e": 3.96, "text": "That supervisor is weak, and it gets tired."}, {"t": 4.26, "e": 7.835, "text": "What the file does is put it outside my head."}, {"t": 8.135, "e": 9.19, "text": "On a page."}, {"t": 9.49, "e": 12.37, "text": "Where it doesn't forget why I started."}], "start": 424.7}, {"id": "5.24", "section": 5, "section_title": "The supervisor", "kind": "anim", "desc": "go up first", "key": "go-up-first", "title": null, "stage": null, "pieces": [], "dur": 21.8333, "words": [{"w": "So", "t": 0.5}, {"w": "if", "t": 0.75}, {"w": "you", "t": 1.0}, {"w": "take", "t": 1.305}, {"w": "one", "t": 1.665}, {"w": "thing", "t": 1.97}, {"w": "from", "t": 2.385}, {"w": "this:", "t": 2.745}, {"w": "before", "t": 3.655}, {"w": "you", "t": 4.125}, {"w": "ask", "t": 4.43}, {"w": "for", "t": 4.735}, {"w": "solutions,", "t": 5.04}, {"w": "from", "t": 5.895}, {"w": "an", "t": 6.255}, {"w": "AI,", "t": 6.505}, {"w": "from", "t": 6.975}, {"w": "a", "t": 7.335}, {"w": "friend,", "t": 7.53}, {"w": "from", "t": 8.22}, {"w": "yourself,", "t": 8.58}, {"w": "go", "t": 9.38}, {"w": "up", "t": 9.63}, {"w": "first.", "t": 9.88}, {"w": "Why", "t": 10.845}, {"w": "am", "t": 11.15}, {"w": "I", "t": 11.4}, {"w": "doing", "t": 11.595}, {"w": "this?", "t": 12.01}, {"w": "And", "t": 12.92}, {"w": "what", "t": 13.225}, {"w": "does", "t": 13.585}, {"w": "it", "t": 13.945}, {"w": "look", "t": 14.195}, {"w": "like", "t": 14.555}, {"w": "when", "t": 14.915}, {"w": "it", "t": 15.275}, {"w": "worked?", "t": 15.525}, {"w": "Five", "t": 17.145}, {"w": "lines.", "t": 17.505}], "lines": [{"t": 0.5, "e": 3.355, "text": "So if you take one thing from this:"}, {"t": 3.655, "e": 10.545, "text": "before you ask for solutions, from an AI, from a friend, from yourself, go up first."}, {"t": 10.845, "e": 12.62, "text": "Why am I doing this?"}, {"t": 12.92, "e": 16.245, "text": "And what does it look like when it worked?"}, {"t": 17.145, "e": 18.17, "text": "Five lines."}], "start": 437.7333}, {"id": "5.25", "section": 5, "section_title": "The supervisor", "kind": "anim", "desc": "thanks for watching", "key": "thanks-for-watching", "title": null, "stage": null, "pieces": [], "dur": 7.0, "words": [], "lines": [], "start": 459.5666}]}